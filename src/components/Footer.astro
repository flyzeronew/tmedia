---
import '../styles/components/footer.css';
---
<footer>
  <div class="footer-inner">
    <div class="footer-logo">
      <a href="/">
        <img
          src="https://cc.t.media/2017news/prd/images/tMedia_logo.png"
          alt="T.Media logo"
          width="80"
          height="42"
        />
      </a>
    </div>
    <div class="footer-links">
      <a href="/">English</a>
      <a href="/about">About Us</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Use</a>
    </div>
    <div class="footer-social">
      <a href="https://twitter.com/tvbsworldtaiwan" target="_blank" rel="noopener noreferrer">
        <img src="https://cc.t.media/2017news/prd/images/FFFFFF-32.png" alt="Twitter/X" width="24" height="24" />
      </a>
    </div>
    <p class="footer-copy">&copy; {new Date().getFullYear()} T.Media / TVBS World Taiwan. All rights reserved.</p>
  </div>
</footer>
