>
  <h1 style="display:none">english | T.media</h1>

  <div class="pg-frame">
    <!-- Main article column -->
    <article class="pg-article">
      <div class="index_new">

        <!-- Hero Carousel -->
        <div class="vision">
          <div class="vision-track" id="visionTrack">
            {heroSlides.map((slide, i) => (
              <a href={slide.href} class="vision-slide" target="_blank">
                <div class="img">
                  <img
                    width="1060"
                    height="596"
                    src={slide.img}
                    alt={slide.alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
                <h2 class="txt"><p>{slide.title}</p></h2>
              </a>
            ))}
          </div>
          <button class="owl-prev" id="visionPrev" aria-label="Previous slide"></button>
          <button class="owl-next" id="visionNext" aria-label="Next slide"></button>
          <div class="owl-dots" id="visionDots">
            {heroSlides.map((_, i) => (
              <button
                class:list={['owl-dot', { active: i === 0 }]}
                data-index={i}
                aria-label={`Slide ${i + 1}`}
              >
                <span></span>
              </button>
            ))}
          </div>
        </div>

        <!-- Latest News Section -->
        <div class="news_now2">
          <div class="title_div">
            <div class="title_line">
              <p>Latest</p>
            </div>
          </div>
          <div class="list">
            <ul id="newsList">
              {newsItems.map((item) => (
                <li>
                  <a href={item.href} target="_blank">
                    <div class="box">
                      <div class="img">
                        <img
                          src={item.img}
                          alt={item.title}
                          loading="lazy"
                          width="338"
                          height="190"
                        />
                        <div class="overlay-color"></div>
                      </div>
                      <div class="txt_box">
                        <h2 class="txt">{item.title}</h2>
                        <div class="time">{item.time}</div>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <div id="scrollTrigger"></div>
            <div id="scrollLoading" class="scroll-loading" aria-hidden="true">
              <span class="scroll-spinner"></span>
            </div>
          </div>

          <script type="application/json" id="mockPool">{JSON.stringify(mockPool)}</script>
        </div>

      </div>
    </article>

    <!-- Sidebar column (desktop only) -->
    <aside class="pg-aside">
      <div class="r_box">

