<script>
  const track = document.getElementById('visionTrack') as HTMLElement;
  const dots = document.querySelectorAll<HTMLButtonElement>('#visionDots .owl-dot');
  const total = dots.length;
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(idx: number) {
    current = (idx + total) % total;
    track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }

  function startTimer() {
    clearInterval(timer);
    timer = setInterval(() => goTo(current + 1), 3000);
  }

  document.getElementById('visionPrev')?.addEventListener('click', () => {
    goTo(current - 1);
    startTimer();
  });

  document.getElementById('visionNext')?.addEventListener('click', () => {
    goTo(current + 1);
    startTimer();
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      goTo(Number(dot.dataset.index));
      startTimer();
    });
  });

  startTimer();

  // ── Infinite scroll ──────────────────────────────────────────
  interface NewsItem { href: string; img: string; title: string; time: string; }

  const pool: NewsItem[] = JSON.parse(
    document.getElementById('mockPool')!.textContent!
  );

  const newsList   = document.getElementById('newsList')!;
  const trigger    = document.getElementById('scrollTrigger')!;
  const loadingEl  = document.getElementById('scrollLoading')!;

  let poolIndex = 0;
  let busy = false;

  function buildCard(item: NewsItem): HTMLLIElement {
    const li = document.createElement('li');
    li.innerHTML = `
      <a href="${item.href}" target="_blank">
        <div class="box">
          <div class="img">
            <img src="${item.img}" alt="${item.title}" loading="lazy" width="338" height="190" />
            <div class="overlay-color"></div>
          </div>
          <div class="txt_box">
            <h2 class="txt">${item.title}</h2>
            <div class="time">${item.time}</div>
          </div>
        </div>
      </a>`;
    return li;
  }

  function loadMore() {
    if (busy) return;
    busy = true;
    loadingEl.style.display = 'flex';

    setTimeout(() => {
      const batch = 9; // 3-col × 3 rows per load
      for (let i = 0; i < batch; i++) {
        newsList.appendChild(buildCard(pool[poolIndex % pool.length]));
        poolIndex++;
      }
      loadingEl.style.display = 'none';
      busy = false;
    }, 800);
  }

  const scrollObserver = new IntersectionObserver(
    (entries) => { if (entries[0].isIntersecting) loadMore(); },
    { rootMargin: '300px' }
  );
  scrollObserver.observe(trigger);
</script>

<script is:inline>
(function () {
  function updateSidebar() {
    if (window.innerWidth < 1024) return;

    var rBox    = document.querySelector('.r_box');
    var article = document.querySelector('.pg-article');
    var header  = document.querySelector('header');
    if (!rBox || !article || !header) return;

    var rBoxH    = rBox.offsetHeight;
    var headerH  = header.offsetHeight;
    var winH     = window.innerHeight;
    var scrollTop = window.scrollY || document.documentElement.scrollTop;
    var totalH   = rBoxH + headerH;

    if (
      article.offsetHeight > totalH &&
      rBoxH > winH - headerH - 100 &&
      scrollTop + winH >= totalH
    ) {
      rBox.style.position = 'fixed';
      rBox.style.bottom   = '0';
    } else {
      rBox.style.position = 'relative';
      rBox.style.bottom   = '';
    }
  }

  window.addEventListener('scroll', updateSidebar);
  window.addEventListener('resize', updateSidebar);
})();
</script>

