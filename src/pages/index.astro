---

<BaseLayout
  title="Breaking News, Latest News and Videos | TVBS World Taiwan"
  description="View the latest news and breaking news today for Taiwan, world, weather, entertainment, politics and health at TVBS World Taiwan."
  ogTitle="Breaking News, Latest News and Videos | TVBS World Taiwan"
  ogDescription="View the latest news and breaking news today for Taiwan, world, weather, entertainment, politics and health at TVBS World Taiwan."
  ogImage="https://cc.t.media/img/upload/2017/11/09/20171109193947-11b8e8d3.png"
>
  <h1 style="display:none">english | T.media</h1>

  <div class="pg-frame">
    <!-- Main article column -->
    <article class="pg-article">
      <div class="index_new">

        <!-- Hero Carousel -->
        <div class="vision swiper">
          <div class="swiper-wrapper">
            {heroSlides.map((slide, i) => (
              <a
                href={slide.href}
                class="swiper-slide vision-slide"
                target={slide.href.startsWith('/') ? undefined : '_blank'}
                rel={slide.href.startsWith('/') ? undefined : 'noopener noreferrer'}
              >
                <div class="img">
                  <img
                    width="1060"
                    height="596"
                    src={slide.img}
                    alt={slide.alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                  <div class="video-play-icon"></div>
                </div>
                <h2 class="txt"><p>{slide.title}</p></h2>
              </a>
            ))}
          </div>
          <button class="owl-prev" aria-label="Previous slide"></button>
          <button class="owl-next" aria-label="Next slide"></button>
        </div>
        <div class="owl-dots"></div>

        <!-- Trending (mobile only) -->
        <Trending class="trending-mobile" />

        <!-- Latest News Section -->
        <div class="news_now2">
          <div class="title_div">
            <div class="title_line">
              <p>Latest</p>
            </div>
          </div>
          <div class="list">
            <ul id="newsList">
              {newsItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.href.startsWith('/') ? undefined : '_blank'}
                    rel={item.href.startsWith('/') ? undefined : 'noopener noreferrer'}
                  >
                    <div class="box">
                      <div class="img">
                        <img
                          src={item.img}
                          alt={item.title}
                          loading="lazy"
                          width="338"
                          height="190"
                        />
                        <div class="overlay-color"></div>
                        {item.videoId && <div class="video-play-icon"></div>}
                      </div>
                      <div class="txt_box">
                        <h2 class="txt">{item.title}</h2>
                        <div class="time">{item.time}</div>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <div id="scrollTrigger"></div>
            <div id="scrollLoading" class="scroll-loading" aria-hidden="true">
              <span class="scroll-spinner"></span>
            </div>
          </div>

          <script type="application/json" id="mockPool">{JSON.stringify(mockPool)}</script>
        </div>

      </div>
    </article>

    <!-- Sidebar column (desktop only) -->
    <Sidebar />
  </div>
</BaseLayout>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';
  import 'swiper/css';

  new Swiper('.vision', {
    modules: [Navigation, Pagination, Autoplay],
    loop: true,
    grabCursor: true,
    autoplay: { delay: 3000, disableOnInteraction: false },
    pagination: {
      el: '.owl-dots',
      clickable: true,
      bulletClass: 'owl-dot',
      bulletActiveClass: 'active',
      renderBullet: (_, className) => `<button class="${className}"><span></span></button>`,
    },
    navigation: {
      prevEl: '.owl-prev',
      nextEl: '.owl-next',
    },
    on: {
      init: (swiper) => {
        (swiper.el as HTMLElement).style.opacity = '1';
      },
    },
  });

  // ── Infinite scroll ──────────────────────────────────────────
  interface NewsItem { href: string; img: string; title: string; time: string; }

  const pool: NewsItem[] = JSON.parse(
    document.getElementById('mockPool')!.textContent!
  );

  const newsList   = document.getElementById('newsList')!;
  const trigger    = document.getElementById('scrollTrigger')!;
  const loadingEl  = document.getElementById('scrollLoading')!;

  let poolIndex = 0;
  let busy = false;

  function buildCard(item: NewsItem): HTMLLIElement {
    const li = document.createElement('li');
    li.innerHTML = `
      <a href="${item.href}" target="_blank">
        <div class="box">
          <div class="img">
            <img src="${item.img}" alt="${item.title}" loading="lazy" width="338" height="190" />
            <div class="overlay-color"></div>
          </div>
          <div class="txt_box">
            <h2 class="txt">${item.title}</h2>
            <div class="time">${item.time}</div>
          </div>
        </div>
      </a>`;
    return li;
  }

  function loadMore() {
    if (busy) return;
    busy = true;
    loadingEl.style.display = 'flex';

    setTimeout(() => {
      const batch = 9; // 3-col × 3 rows per load
      for (let i = 0; i < batch; i++) {
        newsList.appendChild(buildCard(pool[poolIndex % pool.length]));
        poolIndex++;
      }
      loadingEl.style.display = 'none';
      busy = false;
    }, 800);
  }

  const scrollObserver = new IntersectionObserver(
    (entries) => { if (entries[0].isIntersecting) loadMore(); },
    { rootMargin: '300px' }
  );
  scrollObserver.observe(trigger);
</script>

