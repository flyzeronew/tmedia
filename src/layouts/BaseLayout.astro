---
import '../styles/global.css';
import '../styles/layouts/base.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  url?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
}
const { title, description, ogImage, ogTitle, ogDescription, ogUrl } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={ogUrl} />
    <link rel="icon" href="https://cc.t.media/2017news/prd/images/favicon.ico" type="image/icon" />
    <title>{title}</title>
    <!-- Google Publisher Tag -->
    <script async src="https://securepubads.g.doubleclick.net/tag/js/gpt.js"></script>
    <script is:inline>
      window.googletag = window.googletag || {cmd: []};
      var ppid;
      (async function () {
        try {
          var ga = document.cookie.split('; ').find(function (r) { return r.startsWith('_ga='); });
          if (!ga) return;
          var raw = ga.split('=')[1].split('.').slice(2).join('.');
          var buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(raw));
          ppid = Array.from(new Uint8Array(buf)).map(function (b) { return b.toString(16).padStart(2, '0'); }).join('');
        } catch (e) {}
      })();
      var news_tvbs_com_tw_pc_index_list1, news_tvbs_com_tw_pc_index_list2;
      var news_tvbs_com_tw_m_index_list1, news_tvbs_com_tw_m_index_list2, news_tvbs_com_tw_m_index_bottom;
      googletag.cmd.push(function () {
        news_tvbs_com_tw_pc_index_list1 = googletag.defineSlot('/21697024903/news.tvbs.com.tw_pc_index_list1', [300, 250], 'news_tvbs_com_tw_pc_index_list1').addService(googletag.pubads());
        news_tvbs_com_tw_pc_index_list2 = googletag.defineSlot('/21697024903/news.tvbs.com.tw_pc_index_list2', [[300, 250], [300, 600]], 'news_tvbs_com_tw_pc_index_list2').addService(googletag.pubads());
        news_tvbs_com_tw_m_index_list1  = googletag.defineSlot('/21697024903/news.tvbs.com.tw_m_index_list1',  [[300, 250], [336, 280]], 'news_tvbs_com_tw_m_index_list1').addService(googletag.pubads());
        news_tvbs_com_tw_m_index_list2  = googletag.defineSlot('/21697024903/news.tvbs.com.tw_m_index_list2',  [[300, 250], [336, 280]], 'news_tvbs_com_tw_m_index_list2').addService(googletag.pubads());
        news_tvbs_com_tw_m_index_bottom = googletag.defineSlot('/21697024903/news.tvbs.com.tw_m_index_bottom', [[320, 100], [1, 1]],     'news_tvbs_com_tw_m_index_bottom').addService(googletag.pubads());
        googletag.pubads().collapseEmptyDivs();
        googletag.pubads().disableInitialLoad();
        if (ppid) googletag.pubads().setPublisherProvidedId(ppid);
        googletag.enableServices();
      });
      googletag.cmd.push(function () {
        googletag.pubads().setTargeting('news_channel', 'english');
      });
      function detectmob() {
        return /Android|webOS|iPhone|iPad|iPod|BlackBerry|Windows Phone/i.test(navigator.userAgent);
      }
    </script>
  </head>
  <body>
    <div class="container">
      <Header />
      <main>
        <slot />
      </main>
    </div>
    <button id="gotop" aria-label="回到頂部">
      <img src="https://cc.t.media/2017news/prd/images/gotop.png" alt="" width="50" height="50" />
    </button>
    <style>
      #gotop {
        position: fixed;
        right: 20px;
        bottom: 30px;
        z-index: 999;
        border: none;
        padding: 0;
        cursor: pointer;
        width: 40px;
        height: 40px;
        background: rgba(0, 0, 0, .3);
        border-radius: 5px;
        display: block;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s, visibility 0.3s;
      }
      #gotop.visible {
        opacity: 1;
        visibility: visible;
      }
      #gotop img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    </style>
    <script>
      const btn = document.getElementById('gotop')!;
      window.addEventListener('scroll', () => {
        btn.classList.toggle('visible', window.scrollY > 300);
      }, { passive: true });
      btn.addEventListener('click', () => {
        const start = window.scrollY;
        const duration = 600;
        let startTime: number | null = null;

        function easeInOutCubic(t: number) {
          return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        }

        function step(timestamp: number) {
          if (!startTime) startTime = timestamp;
          const elapsed = timestamp - startTime;
          const progress = Math.min(elapsed / duration, 1);
          window.scrollTo(0, start * (1 - easeInOutCubic(progress)));
          if (progress < 1) requestAnimationFrame(step);
        }

        requestAnimationFrame(step);
      });
    </script>
  </body>
</html>
